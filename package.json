{
    "name": "bonus-claim-api",
    "version": "1.0.0",
    "description": "REST API for bonus claiming with MongoDB",
    "main": "app.js",
    "scripts": {
      "start": "node app.js",
      "dev": "nodemon app.js",
      "test": "jest --detectOpenHandles",
      "test:watch": "jest --watch",
      "test:coverage": "jest --coverage",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "format": "prettier --write .",
      "seed": "node scripts/seedDatabase.js"
    },
    "keywords": [
      "nodejs",
      "express",
      "mongodb",
      "mongoose",
      "rest-api",
      "bonus",
      "claims"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
      "express": "^4.18.2",
      "mongoose": "^7.5.0",
      "cors": "^2.8.5",
      "helmet": "^7.0.0",
      "express-rate-limit": "^6.8.1",
      "winston": "^3.10.0",
      "dotenv": "^16.3.1",
      "joi": "^17.9.2",
      "bcryptjs": "^2.4.3",
      "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
      "nodemon": "^3.0.1",
      "jest": "^29.6.2",
      "supertest": "^6.3.3",
      "eslint": "^8.46.0",
      "prettier": "^3.0.0",
      "@types/jest": "^29.5.3"
    },
    "engines": {
      "node": ">=16.0.0",
      "npm": ">=8.0.0"
    },
    "repository": {
      "type": "git",
      "url": "https://github.com/yourusername/bonus-claim-api.git"
    },
    "bugs": {
      "url": "https://github.com/yourusername/bonus-claim-api/issues"
    },
    "homepage": "https://github.com/yourusername/bonus-claim-api#readme"
  }