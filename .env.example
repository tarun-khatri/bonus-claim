# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI="add the atlas URI"

# Security
JWT_SECRET="add-the secret-key"
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Logging
LOG_LEVEL=info

# Rate Limiting
ENABLE_RATE_LIMIT=true

# Security Features
ENABLE_CORS=true
ENABLE_HELMET=true

# External Services
VAULT_LOGGER_ENABLED=true

# Database Options (Optional - defaults are set in config)
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000